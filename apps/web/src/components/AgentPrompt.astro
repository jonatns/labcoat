---
import Icon from './Icon.astro';
import { agentPrompt, agentPromptParagraphs } from '@/agent-prompt';

interface Props {
  /** Unique per page: the copy button selects this element as a fallback. */
  id: string;
}

const { id } = Astro.props;
---

<div class="agent-prompt">
  <div class="agent-prompt-bar">
    <p>Paste this into Claude Code, Codex, or another coding agent with terminal access.</p>
    <button type="button" class="button button-primary" data-copy={agentPrompt} data-copy-target={id} data-copy-idle="Copy agent prompt">
      <Icon name="copy" />
      <span data-copy-label>Copy agent prompt</span>
    </button>
  </div>
  <!-- Closed by default: the button is the action. The text stays one click
       away because it authorizes an installer, and people should be able to
       read what they are about to paste. -->
  <details class="agent-prompt-details">
    <summary>Read the prompt</summary>
    <div class="agent-prompt-text" id={id}>
      {agentPromptParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </details>
</div>
