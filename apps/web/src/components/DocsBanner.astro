---
import brand from '../../../../brand.json';

const notice = brand.docsChannelNotice.replace(
  '`labcoat docs --llm`',
  '<code>labcoat docs --llm</code>',
);
---

<div class="sl-banner" data-pagefind-ignore>
  <span class="channel" aria-hidden="true"><i></i>main</span>
  <span class="notice" set:html={notice} />
  <a href="/docs/reference/stability/">Release details</a>
</div>

<style>
  @layer starlight.core {
    .sl-banner {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.55rem var(--sl-nav-pad-x);
      border-bottom: 1px solid var(--line-soft);
      background: var(--ground);
      color: var(--ink-muted);
      font-size: 0.78rem;
      line-height: 1.45;
    }

    .channel {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 0.4rem;
      color: var(--acid);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .channel i {
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 50%;
      background: currentColor;
    }

    .notice {
      min-width: 0;
      flex: 1;
    }

    .sl-banner a {
      flex: none;
      color: var(--ink-soft);
      font-weight: 600;
      text-decoration-color: color-mix(in oklch, var(--acid), transparent 35%);
      text-underline-offset: 0.2em;
      white-space: nowrap;
    }

    .sl-banner a:hover {
      color: var(--acid);
    }

    .sl-banner :global(code) {
      padding: 0 0.25rem;
      border: 1px solid var(--line-soft);
      background: var(--surface-2);
      color: var(--ink-soft);
      font-size: 0.92em;
    }

    @media (max-width: 50rem) {
      .sl-banner {
        flex-wrap: wrap;
        gap: 0.2rem 0.6rem;
        font-size: 0.74rem;
      }

      .notice {
        flex-basis: 100%;
        order: 3;
      }
    }
  }
</style>
