---
import AgentPrompt from '@/components/AgentPrompt.astro';
import Brand from '@/components/Brand.astro';
import CopyCommand from '@/components/CopyCommand.astro';
import FontPreload from '@/components/FontPreload.astro';
import Icon from '@/components/Icon.astro';
import TerminalDemo from '@/components/TerminalDemo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import '@/styles/global.css';
import '@/styles/landing.css';
import brand from '../../../../brand.json';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: brand.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  description: brand.description,
  url: 'https://labcoat.sh',
  downloadUrl: 'https://github.com/jonatns/labcoat/releases',
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: 'https://github.com/jonatns/labcoat',
};

// deploy.rs sample for the systems section, pre-highlighted.
const manifestHtml = `<span class="k">let</span> usd = d.<span class="k">external</span>(<span class="s">"usd"</span>).id_everywhere(<span class="n">4</span>, <span class="n">65012</span>);

<span class="k">let</span> token = d
    .<span class="k">contract</span>(<span class="s">"token"</span>, <span class="s">"my-token"</span>)
    .reserve(<span class="n">65011</span>)
    .arg(<span class="s">"supply"</span>, <span class="n">100</span>);

d.<span class="k">contract</span>(<span class="s">"market"</span>, <span class="s">"my-market"</span>)
    .arg(<span class="s">"base"</span>, <span class="r">token.id()</span>)
    .arg(<span class="s">"quote"</span>, <span class="r">usd.id()</span>)
    .arg(<span class="s">"expiry"</span>, <span class="r">d.height()</span> + <span class="n">100</span>);`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={brand.metaDescription} />
    <meta name="theme-color" content="#0a0d0b" />
    <link rel="canonical" href="https://labcoat.sh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <FontPreload />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Labcoat" />
    <meta property="og:title" content={brand.metaTitle} />
    <meta property="og:description" content={brand.metaDescription} />
    <meta property="og:url" content="https://labcoat.sh/" />
    <meta property="og:image" content="https://labcoat.sh/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.name}: ${brand.socialHeadline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{brand.metaTitle}</title>
    <script is:inline>
      (() => {
        // Same key and values as the docs (Starlight), so one choice applies
        // across the whole site. 'auto' or nothing follows the system.
        let saved = null;
        try { saved = localStorage.getItem('starlight-theme'); } catch {}
        const system = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : system;
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <Brand />
      <nav aria-label="Primary navigation">
        <a href="/docs/">Docs</a>
        <a href="/docs/tutorials/first-contract/">Tutorial</a>
        <a href="https://github.com/jonatns/labcoat">GitHub</a>
      </nav>
      <ThemeToggle />
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Rust-native Alkanes development</p>
          <h1 id="hero-title"><span>From Rust source</span> <em>to decoded trace.</em></h1>
          <p class="hero-lede">{brand.description}</p>
          <div class="start">
            <div class="start-tabs" role="tablist" aria-label="How to start">
              <button type="button" role="tab" id="start-tab-agent" aria-controls="start-panel-agent" aria-selected="true" tabindex="0">Agent</button>
              <button type="button" role="tab" id="start-tab-manual" aria-controls="start-panel-manual" aria-selected="false" tabindex="-1">Manual</button>
            </div>
            <div class="start-panel" role="tabpanel" id="start-panel-agent" aria-labelledby="start-tab-agent">
              <AgentPrompt id="hero-agent-prompt" />
              <p class="start-note"><a href="/docs/getting-started/agent-onboarding/">What your agent checks before it installs anything <span aria-hidden="true">→</span></a></p>
            </div>
            <div class="start-panel" role="tabpanel" id="start-panel-manual" aria-labelledby="start-tab-manual" hidden>
              <CopyCommand command="curl -fsSL https://labcoat.sh/install | sh" label="Copy install command" />
              <p class="start-note">Installs the latest stable release to <code>~/.local/bin</code> after verifying its checksum. <a href="/docs/getting-started/installation/">Platform support and other ways to install <span aria-hidden="true">→</span></a></p>
            </div>
          </div>
          <p class="hero-support">macOS and Linux · arm64 and x86_64 · MIT licensed</p>
          <div class="hero-actions">
            <a class="button button-ghost" href="/docs/getting-started/quickstart/">{brand.ctas.primary} <span aria-hidden="true">→</span></a>
            <a class="button button-ghost" href="https://github.com/jonatns/labcoat">{brand.ctas.secondary}</a>
          </div>
          <p class="maturity-notice"><Icon name="warning" size={16} label="Early-stage notice" />{brand.maturityNotice}</p>
        </div>
        <div class="hero-demo">
          <TerminalDemo />
          <p class="demo-note">Abridged from the <a href="/docs/getting-started/quickstart/">quick start</a>.</p>
        </div>
      </section>

      <section class="section" id="network" aria-labelledby="network-title">
        <div class="section-intro">
          <h2 id="network-title">{brand.proofPoints.localEnvironment}.</h2>
          <p>Labcoat Network is local, private, and resettable: Bitcoin regtest underneath, not Signet, running inside the <code>labcoat</code> binary with the Alkanes indexer pinned to your CLI release. The same <code>labcoat</code> command that builds your contract starts the chain, funds the wallet, and reads the result back.</p>
        </div>
        <dl class="command-list" aria-label="Selected labcoat commands">
          <div><dt><code>labcoat test</code></dt><dd>Build WASIp1 WebAssembly and run native Rust integration tests</dd></div>
          <div><dt><code>labcoat up</code></dt><dd>Prepare this CLI release's exact runtime bundle and boot Labcoat Network</dd></div>
          <div><dt><code>labcoat fund</code></dt><dd>Send BTC from the dev wallet to an address</dd></div>
          <div><dt><code>labcoat deploy</code></dt><dd>Execute the pending deployment steps deploy.rs declares, or one of them by name</dd></div>
          <div><dt><code>labcoat simulate</code></dt><dd>Simulate a deployed contract against live indexed chain state</dd></div>
          <div><dt><code>labcoat trace</code></dt><dd>Decoded protostone traces for a transaction</dd></div>
          <div><dt><code>labcoat snapshot</code></dt><dd>Snapshot the Labcoat Network data directory (stops services first)</dd></div>
          <div><dt><code>labcoat reset</code></dt><dd>Stop services and wipe all chain/index data</dd></div>
        </dl>
        <a class="text-link" href="/docs/labcoat-network/">How Labcoat Network works <span aria-hidden="true">→</span></a>
      </section>

      <section class="section" id="systems" aria-labelledby="systems-title">
        <div class="section-intro">
          <h2 id="systems-title">Deploy the system, not just the contract.</h2>
          <p>Declare several contracts and the references between them in <code>deploy.rs</code>. <code>labcoat plan</code> shows what has not run yet, and <code>labcoat deploy</code> runs each step once; deploying an unchanged script does nothing, and new code behind a proxy goes out as an upgrade.</p>
        </div>
        <div class="systems-layout">
          <figure class="code-window">
            <figcaption>deploy.rs</figcaption>
            <pre tabindex="0" aria-label="Example deploy.rs deployment script"><code set:html={manifestHtml} /></pre>
            <pre class="code-window-output" tabindex="0" aria-label="labcoat plan output"><code><span class="t-prompt" aria-hidden="true">$ </span>labcoat plan
<span class="t-info">› Plan for deploy.rs — 2 pending step(s)</span></code></pre>
          </figure>
          <dl class="feature-list">
            <div><dt>Network e2e tests</dt><dd>Deploy the script on a network of the project's own and drive multi-wallet flows from Rust with <code>labcoat test --e2e</code>.</dd></div>
            <div><dt>Atomic exchanges</dt><dd>Swap two Alkane assets between wallets in one transaction, locally or through a seller-last PSBT ceremony.</dd></div>
            <div><dt>Web clients</dt><dd>Generate a typed TypeScript client for balances and simulations with <code>labcoat generate web</code>.</dd></div>
            <div><dt>Deployment history</dt><dd>Keep every instance of every contract, and refuse to deploy onto a chain that was reset.</dd></div>
            <div><dt>Project upgrades</dt><dd>Move a project's alkanes-rs, test harness, and Rust pins to the installed release with <code>labcoat upgrade</code>.</dd></div>
          </dl>
        </div>
        <a class="text-link" href="/docs/tutorials/token-exchange/">Build two tokens and swap them <span aria-hidden="true">→</span></a>
      </section>

      <section class="section" id="agents" aria-labelledby="agents-title">
        <div class="section-intro">
          <h2 id="agents-title">{brand.proofPoints.agents}.</h2>
          <p>Every command can answer in a versioned JSON envelope on stdout, with diagnostics on stderr. Failures carry a stable code and a hint naming the next command, so scripts branch on the code and agents know what to try next.</p>
        </div>
        <div class="agents-layout">
          <figure class="code-window">
            <figcaption>labcoat --json simulate counter get_count</figcaption>
            <pre tabindex="0" aria-label="Example Labcoat JSON error envelope"><code>{'{'}
  <span class="j-key">"command"</span>: <span class="j-str">"simulate"</span>,
  <span class="j-key">"error"</span>: {'{'}
    <span class="j-key">"code"</span>: <span class="j-code">"CONTRACT_NOT_FOUND"</span>,
    <span class="j-key">"hint"</span>: <span class="j-str">"deploy the contract first or pass its block:tx id directly"</span>,
    <span class="j-key">"message"</span>: <span class="j-str">"no deployment of 'counter' on labcoat in labcoat.lock"</span>
  {'}'},
  <span class="j-key">"ok"</span>: <span class="j-bool">false</span>,
  <span class="j-key">"schema"</span>: <span class="j-str">"labcoat/v1/error"</span>
{'}'}</code></pre>
          </figure>
          <div class="agents-copy">
            <h3>MCP server</h3>
            <p><code>labcoat mcp serve</code> exposes Labcoat Network, wallets, builds, deploys, deployment scripts, exchanges, state, and traces as typed tools over stdio.</p>
            <h3>Context for coding agents</h3>
            <p>These files are generated from the CLI on <code>main</code>. <code>labcoat docs --llm</code> prints the same reference for the version you have installed.</p>
            <ul class="link-list">
              <li><a href="/docs/getting-started/agent-onboarding/">Start with an agent</a></li>
              <li><a href="/llms.txt">/llms.txt</a></li>
              <li><a href="/llms-full.txt">/llms-full.txt</a></li>
              <li><a href="/reference/cli.json">/reference/cli.json</a></li>
              <li><a href="/skill.md">/skill.md</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <h2 id="closing-title">{brand.ctas.expressive}.</h2>
        <AgentPrompt id="closing-agent-prompt" />
        <p><a href="/docs/getting-started/quickstart/">Or follow the manual quick start <span aria-hidden="true">→</span></a></p>
      </section>
    </main>

    <footer class="site-footer">
      <Brand />
      <p>{brand.category}.</p>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/llms.txt">llms.txt</a><a href="https://github.com/jonatns/labcoat">GitHub</a><a href="https://opensource.org/license/mit">MIT License</a></nav>
      <p class="footer-meta">Built in Puerto Rico · Open source</p>
    </footer>

    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>

    <script>
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = theme;
        try {
          localStorage.setItem('starlight-theme', theme);
        } catch {
          // Storage can be unavailable (private windows); the choice still applies to this page.
        }
      });

      const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        const label = button.querySelector('[data-copy-label]');
        const idle = button.dataset.copyIdle ?? 'Copy';
        const say = (text: string, announcement: string) => {
          if (label) label.textContent = text;
          if (copyStatus) copyStatus.textContent = announcement;
        };
        const reset = () => {
          say(idle, '');
          delete button.dataset.copied;
        };
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            say('Copied', 'Copied to the clipboard.');
            button.dataset.copied = 'true';
          } catch {
            // No clipboard access: select the text so the reader can copy it.
            const target = button.dataset.copyTarget
              ? document.getElementById(button.dataset.copyTarget)
              : button.parentElement?.querySelector('code');
            if (target) window.getSelection()?.selectAllChildren(target);
            say('Selected', 'The clipboard is unavailable. The text is selected; copy it with your keyboard.');
          }
          window.setTimeout(reset, 1800);
        });
      });

      // Every tab list on the page: the start toggle and the terminal demo.
      document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement) => {
          for (const item of tabs) {
            const selected = item === tab;
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
            const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
            if (panel) panel.hidden = !selected;
          }
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => select(tab));
          tab.addEventListener('keydown', (event) => {
            const moves: Record<string, number> = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: tabs.length - 1 };
            if (!(event.key in moves)) return;
            event.preventDefault();
            const next = tabs[(moves[event.key] + tabs.length) % tabs.length];
            next.focus();
            select(next);
          });
        });
      });
    </script>
  </body>
</html>
