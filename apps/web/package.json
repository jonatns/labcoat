{
  "name": "@labcoat/web",
  "version": "0.1.0",
  "private": true,
  "description": "Labcoat is the Rust-native CLI for building, testing, and operating Alkanes smart contracts on Labcoat Network, a managed local Bitcoin regtest.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "sync:reference": "node scripts/sync-reference.mjs",
    "check:reference": "node scripts/sync-reference.mjs --check",
    "generate:og": "node scripts/generate-og.mjs",
    "check:og": "node scripts/generate-og.mjs --check",
    "verify:build": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/starlight": "^0.43.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3"
  }
}
