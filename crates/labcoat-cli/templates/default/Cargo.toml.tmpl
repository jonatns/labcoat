[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]
resolver = "2"
members = ["contracts/*"]

[workspace.dependencies]
# Keep these revisions synchronized with the Labcoat release and TOOLCHAIN.md.
alkanes-runtime = { git = "https://github.com/kungfuflex/alkanes-rs", rev = "ea38c878931ff4b6dd64dd011962f2203d6e0a35" }
alkanes-support = { git = "https://github.com/kungfuflex/alkanes-rs", rev = "ea38c878931ff4b6dd64dd011962f2203d6e0a35" }
metashrew-support = { git = "https://github.com/kungfuflex/metashrew", tag = "v9.0.5-rc.8" }
anyhow = "1.0"

[dev-dependencies]
labcoat-deploy = { git = "https://github.com/jonatns/labcoat", tag = "cli-v{{LABCOAT_VERSION}}" }
labcoat-test = { git = "https://github.com/jonatns/labcoat", tag = "cli-v{{LABCOAT_VERSION}}" }

# The deployment script `labcoat plan` and `labcoat apply` run.
[[example]]
name = "deploy"
path = "deploy.rs"
