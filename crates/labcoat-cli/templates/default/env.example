# Copy this file to .env and fill it in. Labcoat reads .env from the project
# root, and .gitignore keeps it out of git. A variable already set in your
# shell wins over this file.

# Subfrost API key, used by --network signet and --network mainnet. Without
# one Subfrost allows 20 requests a minute, which a deploy exceeds.
# Create one at https://api.subfrost.io
SUBFROST_API_KEY=
