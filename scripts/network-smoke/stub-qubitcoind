#!/usr/bin/env python3
"""Small Qubitcoin RPC stub used only by the Labcoat Network smoke test."""

import hashlib
import json
import re
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

if "--version" in sys.argv:
    print("qubitcoind 0.1.0-stub")
    sys.exit(0)

PORT = 18443
for arg in sys.argv[1:]:
    match = re.match(r"-rpcport=(\d+)", arg)
    if match:
        PORT = int(match.group(1))

STATE = {"height": 0, "blocks": {}, "utxos": {}}


def digest(seed):
    return hashlib.sha256(seed.encode()).hexdigest()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        print("[stub-qubitcoind]", fmt % args, flush=True)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length) or b"{}")
        method = request.get("method", "")
        params = request.get("params", [])
        result, error = None, None

        if method == "getblockchaininfo":
            result = {"chain": "regtest", "blocks": STATE["height"]}
        elif method == "getblockcount":
            result = STATE["height"]
        elif method == "getmempoolinfo":
            result = {"size": 0}
        elif method == "secondaryheight":
            result = STATE["height"]
        elif method == "generatetoaddress":
            hashes = []
            for _ in range(int(params[0])):
                STATE["height"] += 1
                height = STATE["height"]
                block_hash = digest(f"block-{height}")
                txid = digest(f"coinbase-{height}")
                STATE["blocks"][block_hash] = {"height": height, "tx": [txid]}
                STATE["utxos"][f"{txid}:0"] = height
                hashes.append(block_hash)
            result = hashes
        elif method == "getblockhash":
            result = digest(f"block-{int(params[0])}")
        elif method == "getblock":
            block = STATE["blocks"].get(params[0], {"height": 0, "tx": []})
            result = {"height": block["height"], "time": 1752400000, "tx": block["tx"]}
        elif method == "gettxout":
            mined_at = STATE["utxos"].get(f"{params[0]}:{int(params[1])}")
            result = None if mined_at is None else {
                "confirmations": STATE["height"] - mined_at + 1,
                "value": 50.0,
                "coinbase": True,
            }
        elif method == "sendrawtransaction":
            result = digest(params[0])
        else:
            error = {"code": -32601, "message": f"Method not found: {method}"}

        body = json.dumps({
            "jsonrpc": "2.0",
            "id": request.get("id"),
            "result": result,
            "error": error,
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


if __name__ == "__main__":
    print(f"[stub-qubitcoind] listening on {PORT}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
